---
import MainLayout from "../../layouts/MainLayout.astro";
import { getIncidentsByMonitor } from "../../lib/incidents";
import { incidentCategoryLabel } from "../../lib/incidentCategories";

const monitorId = Astro.cookies.get("monitor_id")?.value;

if (!monitorId) {
  return Astro.redirect("/login?redirect=/incidencias/anteriors");
}

const myIncidents = await getIncidentsByMonitor(monitorId);
const previous = myIncidents.filter((i) => i.reviewed);

function studentName(i: typeof previous[number]): string {
  if (!i.child) return "Desconegut";
  return `${i.child.first_name} ${i.child.last_name}`;
}

function classGroup(i: typeof previous[number]): string {
  if (!i.child?.class) return "";
  return i.child.class.name;
}
---

<MainLayout title="Incidències Anteriors">
  <div class="flex-1 flex flex-col min-h-0">
    <header
      class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 py-3 flex items-center justify-between shadow-sm"
    >
      <a
        href="/incidencias"
        class="p-2 -ml-2 text-slate-500 hover:text-slate-800 rounded-full hover:bg-slate-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      </a>
      <h1 class="text-lg font-bold text-slate-900">Incidències anteriors</h1>
      <div class="w-10"></div>
    </header>

    <div class="flex-1 overflow-y-auto px-4 pt-4 pb-6">
      {previous.length > 0 ? (
        <div class="space-y-2">
          {previous.map((incident) => (
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
              <div class="flex items-start justify-between">
                <div>
                  <p class="font-bold text-slate-900">{studentName(incident)}</p>
                  <p class="text-xs text-slate-500">{classGroup(incident)}</p>
                </div>
                <span class="text-xs bg-slate-100 text-slate-500 font-medium px-2 py-1 rounded-full">
                  Revisat
                </span>
              </div>
              <div class="mt-3 flex flex-wrap gap-1.5">
                <span class="text-xs bg-slate-100 text-slate-700 px-2 py-1 rounded-lg border border-slate-200">
                  {incidentCategoryLabel(incident.category)}
                </span>
                {incident.requires_family_signature && (
                  <span class="text-xs bg-purple-50 text-purple-600 px-2 py-1 rounded-lg border border-purple-100">
                    Requereix signatura
                  </span>
                )}
                {incident.send_notification && (
                  <span class="text-xs bg-blue-50 text-blue-600 px-2 py-1 rounded-lg border border-blue-100">
                    Notificació enviada
                  </span>
                )}
              </div>
              {incident.description && (
                <p class="text-sm text-slate-500 mt-2 italic">
                  "{incident.description}"
                </p>
              )}
              {incident.family_response && (
                <div class="mt-2 pt-2 border-t border-slate-100">
                  <p class="text-xs text-slate-500 font-medium">Resposta familiar:</p>
                  <p class="text-sm text-slate-600 italic mt-1">"{incident.family_response}"</p>
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 text-center">
          <p class="text-slate-400 text-sm">No hi ha incidències anteriors</p>
        </div>
      )}
    </div>
  </div>
</MainLayout>
