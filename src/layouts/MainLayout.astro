---
import '../styles/global.css';
interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<!doctype html>
<html lang="es" class="h-full bg-gray-50 antialiased touch-manipulation">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="h-full flex flex-col text-gray-900">
    <main class={`flex-1 flex flex-col ${className || ''}`}>
      <slot />
    </main>
  </body>
</html>

<style>
  /* Base styles for better mobile feel */
  html, body {
    overscroll-behavior-y: none; /* Prevent pull-to-refresh on mobile if not desired */
  }
</style>
