---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Trabajadores" requiresAuth={false}>
  <section
    class="flex flex-1 flex-col items-center justify-center px-6 py-12 text-center"
  >
    <div class="w-full max-w-sm space-y-4">
      <h1 class="text-2xl font-bold tracking-tight text-emerald-900">
        Preparando este dispositivo
      </h1>
      <p class="text-slate-500">
        El espacio de trabajadores estará disponible en la siguiente entrega.
      </p>
    </div>
  </section>
</MainLayout>
