---
import "../styles/global.css";
import AuthGuard from "../components/AuthGuard";
interface Props {
  title: string;
  class?: string;
  requiresAuth?: boolean;
}

const { title, class: className, requiresAuth = true } = Astro.props;
---

<!doctype html>
<html lang="es" class="h-full bg-gray-50 antialiased touch-manipulation">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#047857" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link
      rel="apple-touch-startup-image"
      href="/splash/ipad-portrait.png"
      media="(orientation: portrait) and (min-device-width: 768px)"
    />
    <link
      rel="apple-touch-startup-image"
      href="/splash/ipad-landscape.png"
      media="(orientation: landscape) and (min-device-width: 768px)"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="h-full flex flex-col text-gray-900">
    <main class={`flex-1 flex flex-col ${className || ""}`}>
      {
        requiresAuth && (
          <AuthGuard client:only="react" contentId="protected-content" />
        )
      }
      <div id="protected-content" hidden={requiresAuth} class="contents">
        <slot />
      </div>
    </main>
  </body>
</html>

<script>
  if (typeof window !== "undefined" && "serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker
        .register("/sw.js", { scope: "/" })
        .catch((error) => {
          console.warn("Service worker registration failed", error);
        });
    });
  }
</script>

<style>
  /* Base styles for better mobile feel */
  html,
  body {
    overscroll-behavior-y: none; /* Prevent pull-to-refresh on mobile if not desired */
  }
</style>
