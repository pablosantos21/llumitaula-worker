---
import MainLayout from "../layouts/MainLayout.astro";
import Input from "../components/Input.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
---

<MainLayout title="Login Monitor">
    <div class="flex-1 flex flex-col justify-center px-6 py-12 bg-white">
        <div class="w-full max-w-sm mx-auto space-y-8">
            <div class="text-center space-y-2">
                <h1 class="text-3xl font-bold tracking-tight text-emerald-900">
                    Llumitaula
                </h1>
                <p class="text-slate-500">Acceso para monitores</p>
            </div>

            <form class="space-y-6" action="/" method="get">
                <Input
                    type="email"
                    name="email"
                    label="Correo electrónico"
                    placeholder="nombre@ejemplo.com"
                    required
                />

                <Input
                    type="password"
                    name="password"
                    label="Contraseña"
                    required
                />

                <div class="pt-2">
                    <PrimaryButton type="submit" fullWidth>
                        Entrar
                    </PrimaryButton>
                </div>
            </form>
        </div>
    </div>
</MainLayout>
