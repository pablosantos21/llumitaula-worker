---
import PrimaryButton from "./PrimaryButton.astro";
import Textarea from "./Textarea.astro";

// This component will be hidden by default and shown via JS
---

<div
    id="incident-modal"
    class="fixed inset-0 z-50 invisible opacity-0 transition-all duration-300 flex items-end md:items-center justify-center pointer-events-none"
    role="dialog"
    aria-modal="true"
>
    <!-- Backdrop -->
    <div
        class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity pointer-events-auto"
        id="modal-backdrop"
    >
    </div>

    <!-- Sheet -->
    <div
        class="bg-white rounded-t-3xl md:rounded-2xl p-6 shadow-2xl transform translate-y-full transition-transform duration-300 flex flex-col max-h-[90vh] overflow-y-auto w-full md:w-[600px] md:max-w-[90vw] pointer-events-auto relative"
        id="modal-sheet"
    >
        <!-- Handle -->
        <div class="w-12 h-1.5 bg-slate-200 rounded-full mx-auto mb-6 shrink-0">
        </div>

        <div class="flex items-center justify-between mb-6">
            <h2
                id="modal-student-name"
                class="text-2xl font-bold text-slate-900"
            >
                Alumno
            </h2>
            <button
                type="button"
                class="text-slate-400 p-2 -mr-2"
                id="close-modal"
            >
                <span class="sr-only">Cerrar</span>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="w-6 h-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <form id="incident-form" class="space-y-6">
            <input type="hidden" name="studentId" id="modal-student-id" />

            <!-- Quick Status Toggles -->
            <div class="space-y-3">
                <label
                    class="flex items-center justify-between p-4 rounded-xl border-2 border-slate-100 has-[:checked]:border-red-100 has-[:checked]:bg-red-50 transition-colors cursor-pointer touch-manipulation"
                >
                    <span class="font-medium text-slate-700"
                        >No ha comido primero</span
                    >
                    <input
                        type="checkbox"
                        name="noFirst"
                        class="w-6 h-6 rounded border-slate-300 text-red-600 focus:ring-red-500"
                    />
                </label>

                <label
                    class="flex items-center justify-between p-4 rounded-xl border-2 border-slate-100 has-[:checked]:border-red-100 has-[:checked]:bg-red-50 transition-colors cursor-pointer touch-manipulation"
                >
                    <span class="font-medium text-slate-700"
                        >No ha comido segundo</span
                    >
                    <input
                        type="checkbox"
                        name="noSecond"
                        class="w-6 h-6 rounded border-slate-300 text-red-600 focus:ring-red-500"
                    />
                </label>

                <label
                    class="flex items-center justify-between p-4 rounded-xl border-2 border-slate-100 has-[:checked]:border-red-100 has-[:checked]:bg-red-50 transition-colors cursor-pointer touch-manipulation"
                >
                    <span class="font-medium text-slate-700"
                        >No ha comido guarnición</span
                    >
                    <input
                        type="checkbox"
                        name="noGarnish"
                        class="w-6 h-6 rounded border-slate-300 text-red-600 focus:ring-red-500"
                    />
                </label>

                <label
                    class="flex items-center justify-between p-4 rounded-xl border-2 border-slate-100 has-[:checked]:border-red-100 has-[:checked]:bg-red-50 transition-colors cursor-pointer touch-manipulation"
                >
                    <span class="font-medium text-slate-700"
                        >No ha comido postre</span
                    >
                    <input
                        type="checkbox"
                        name="noDessert"
                        class="w-6 h-6 rounded border-slate-300 text-red-600 focus:ring-red-500"
                    />
                </label>
            </div>

            <Textarea
                name="comments"
                label="Comentarios adicionales"
                placeholder="Detalla si es necesario..."
            />

            <div class="pt-2 flex gap-3">
                <PrimaryButton
                    variant="outline"
                    class="flex-1"
                    id="mark-all-good"
                >
                    Todo bien
                </PrimaryButton>
                <PrimaryButton type="submit" variant="primary" class="flex-[2]">
                    Guardar Cambios
                </PrimaryButton>
            </div>
        </form>
    </div>
</div>

<script>
    const modal = document.getElementById("incident-modal");
    const sheet = document.getElementById("modal-sheet");
    const backdrop = document.getElementById("modal-backdrop");
    const closeBtn = document.getElementById("close-modal");
    const markAllGoodBtn = document.getElementById("mark-all-good");
    const form = document.getElementById("incident-form") as HTMLFormElement;

    const studentNameEl = document.getElementById("modal-student-name");
    const studentIdInput = document.getElementById(
        "modal-student-id",
    ) as HTMLInputElement;

    function openModal(data: any) {
        if (!modal || !sheet) return;

        // Set data
        if (studentNameEl) studentNameEl.textContent = data.name;
        if (studentIdInput) studentIdInput.value = data.id;

        // Reset form
        form.reset();

        // Show
        modal.classList.remove("invisible", "opacity-0");
        sheet.classList.remove("translate-y-full");
    }

    function closeModal() {
        if (!modal || !sheet) return;
        sheet.classList.add("translate-y-full");
        modal.classList.add("opacity-0");
        setTimeout(() => {
            modal.classList.add("invisible");
        }, 300);
    }

    // Listeners
    document.addEventListener("open-student-modal", ((e: CustomEvent) => {
        openModal(e.detail);
    }) as EventListener);

    closeBtn?.addEventListener("click", closeModal);
    backdrop?.addEventListener("click", closeModal);

    markAllGoodBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        // Logic to mark as "All good" immediately
        const event = new CustomEvent("save-student-status", {
            detail: {
                studentId: studentIdInput.value,
                status: "all_good",
            },
        });
        document.dispatchEvent(event);
        closeModal();
    });

    form?.addEventListener("submit", (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const incidentData = {
            studentId: formData.get("studentId"),
            noFirst: formData.get("noFirst") === "on",
            noSecond: formData.get("noSecond") === "on",
            noGarnish: formData.get("noGarnish") === "on",
            noDessert: formData.get("noDessert") === "on",
            comments: formData.get("comments"),
            status: "incident", // If any checkbox is checked or comment added, mostly incident.
        };

        // Simple logic: if no checks, it's arguably 'all_good' but user clicked save on this form,
        // usually implying an edit. Let's send the data.

        const event = new CustomEvent("save-student-status", {
            detail: incidentData,
        });
        document.dispatchEvent(event);
        closeModal();
    });
</script>
