---
import MainLayout from "../../layouts/MainLayout.astro";
import { createIncident, getClassesWithChildren } from "../../lib/incidents";
import {
  INCIDENT_CATEGORIES,
  INCIDENT_CATEGORY_LABELS,
  isIncidentCategory,
} from "../../lib/incidentCategories";

const monitorId = Astro.cookies.get("monitor_id")?.value;

if (!monitorId) {
  return Astro.redirect("/login?redirect=/incidencias/nova");
}

const classesWithChildren = await getClassesWithChildren(monitorId);

let formError: string | null = null;

// Handle form submission
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const kidId = formData.get("kid")?.toString();
  const categoryValue = formData.get("category")?.toString() ?? "";
  const date = formData.get("date")?.toString() || new Date().toISOString().split("T")[0];
  const comments = formData.get("comments")?.toString() || "";
  const requiresSignature = formData.get("requiresSignature") === "on";
  const sendNotification = formData.get("sendNotification") === "on";

  if (!kidId) {
    formError = "Cal triar un alumne per crear la incidència.";
  } else if (!isIncidentCategory(categoryValue)) {
    formError = "Cal triar una categoria per crear la incidència.";
  } else {
    await createIncident({
      child_id: kidId,
      monitor_id: monitorId,
      category: categoryValue,
      date,
      description: comments,
      requires_family_signature: requiresSignature,
      send_notification: sendNotification,
      reviewed: false,
      family_seen: false,
      monitor_validated: false,
    });

    return Astro.redirect("/incidencias");
  }
}

const todayStr = new Date().toISOString().split("T")[0];
// Used in the markup `<script type="application/json">` below, which the Astro
// ESLint processor doesn't track as a usage.
// eslint-disable-next-line @typescript-eslint/no-unused-vars
const studentsJson = JSON.stringify(
  classesWithChildren.flatMap((c) =>
    c.children.map((ch) => ({ id: ch.id, name: ch.name, classGroup: c.className })),
  ),
);
---

<MainLayout title="Nova Incidència">
  <div class="flex-1 flex flex-col min-h-0">
    <header
      class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 py-3 flex items-center justify-between shadow-sm"
    >
      <a
        href="/incidencias"
        class="p-2 -ml-2 text-slate-500 hover:text-slate-800 rounded-full hover:bg-slate-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      </a>
      <h1 class="text-lg font-bold text-slate-900">Nova incidència</h1>
      <div class="w-10"></div>
    </header>

    <div class="flex-1 overflow-y-auto px-4 pt-4 pb-6">
      {formError && (
        <p
          role="alert"
          class="mb-4 rounded-xl bg-red-50 px-4 py-3 text-sm font-medium text-red-800 border border-red-100"
        >
          {formError}
        </p>
      )}
      <form method="POST" class="space-y-5">
        <!-- Class selector -->
        <div class="flex flex-col gap-1.5">
          <label for="class-select" class="text-sm font-medium text-slate-700 ml-1">
            Classe
          </label>
          <select
            id="class-select"
            required
            class="h-12 px-4 rounded-xl border border-slate-200 bg-white text-slate-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22%239CA3AF%22%3E%3Cpath%20fill-rule%3D%22evenodd%22%20d%3D%22M5.23%207.21a.75.75%200%20011.06.02L10%2011.168l3.71-3.938a.75.75%200%20111.08%201.04l-4.25%204.5a.75.75%200%2001-1.08%200l-4.25-4.5a.75.75%200%2001.02-1.06z%22%20clip-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.5rem] bg-[right_0.75rem_center] bg-no-repeat pr-10"
          >
            <option value="">Selecciona una classe</option>
            {classesWithChildren.map((c) => (
              <option value={c.className}>{c.className}</option>
            ))}
          </select>
        </div>

        <!-- Kid selector -->
        <div class="flex flex-col gap-1.5">
          <label for="kid-select" class="text-sm font-medium text-slate-700 ml-1">
            Alumne
          </label>
          <select
            id="kid-select"
            name="kid"
            required
            class="h-12 px-4 rounded-xl border border-slate-200 bg-white text-slate-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22%239CA3AF%22%3E%3Cpath%20fill-rule%3D%22evenodd%22%20d%3D%22M5.23%207.21a.75.75%200%20011.06.02L10%2011.168l3.71-3.938a.75.75%200%20111.08%201.04l-4.25%204.5a.75.75%200%2001-1.08%200l-4.25-4.5a.75.75%200%2001.02-1.06z%22%20clip-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.5rem] bg-[right_0.75rem_center] bg-no-repeat pr-10"
          >
            <option value="">Selecciona un alumne</option>
          </select>
        </div>

        <!-- Category -->
        <div class="flex flex-col gap-1.5">
          <label for="incident-category" class="text-sm font-medium text-slate-700 ml-1">
            Categoria
          </label>
          <select
            id="incident-category"
            name="category"
            required
            class="h-12 px-4 rounded-xl border border-slate-200 bg-white text-slate-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22%239CA3AF%22%3E%3Cpath%20fill-rule%3D%22evenodd%22%20d%3D%22M5.23%207.21a.75.75%200%20011.06.02L10%2011.168l3.71-3.938a.75.75%200%20111.08%201.04l-4.25%204.5a.75.75%200%2001-1.08%200l-4.25-4.5a.75.75%200%2001.02-1.06z%22%20clip-rule%3D%22evenodd%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.5rem] bg-[right_0.75rem_center] bg-no-repeat pr-10"
          >
            <option value="">Selecciona una categoria</option>
            {INCIDENT_CATEGORIES.map((category) => (
              <option value={category}>{INCIDENT_CATEGORY_LABELS[category]}</option>
            ))}
          </select>
        </div>

        <!-- Date -->
        <div class="flex flex-col gap-1.5">
          <label for="incident-date" class="text-sm font-medium text-slate-700 ml-1">
            Data
          </label>
          <input
            id="incident-date"
            name="date"
            type="date"
            value={todayStr}
            class="h-12 px-4 rounded-xl border border-slate-200 bg-white text-slate-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all"
          />
        </div>

        <!-- Description -->
        <div class="flex flex-col gap-1.5">
          <label for="incident-comments" class="text-sm font-medium text-slate-700 ml-1">
            Descripció de la incidència
          </label>
          <textarea
            id="incident-comments"
            name="comments"
            rows="4"
            placeholder="Explica què ha passat..."
            class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all resize-none"
          ></textarea>
        </div>

        <!-- Toggles -->
        <div class="space-y-4 bg-white rounded-2xl border border-slate-100 p-4">
          <label class="flex items-center justify-between cursor-pointer touch-manipulation">
            <div class="flex flex-col">
              <span class="text-sm font-medium text-slate-800">Requereix signatura familiar</span>
              <span class="text-xs text-slate-500">La família ha de signar la incidència</span>
            </div>
            <input type="hidden" name="requiresSignature" value="off" />
            <input
              type="checkbox"
              name="requiresSignature"
              class="sr-only peer"
            />
            <div class="relative w-11 h-6 bg-slate-200 peer-checked:bg-emerald-500 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:start-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
          </label>

          <div class="border-t border-slate-100"></div>

          <label class="flex items-center justify-between cursor-pointer touch-manipulation">
            <div class="flex flex-col">
              <span class="text-sm font-medium text-slate-800">Enviar notificació a l'escola</span>
              <span class="text-xs text-slate-500">L'escola rebrà un avís</span>
            </div>
            <input type="hidden" name="sendNotification" value="off" />
            <input
              type="checkbox"
              name="sendNotification"
              class="sr-only peer"
            />
            <div class="relative w-11 h-6 bg-slate-200 peer-checked:bg-emerald-500 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:start-0.5 after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-full"></div>
          </label>
        </div>

        <button
          type="submit"
          class="w-full h-14 bg-emerald-600 text-white rounded-2xl font-bold text-lg flex items-center justify-center gap-2 active:scale-[0.98] transition-transform shadow-md hover:bg-emerald-700"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
            <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
          </svg>
          Crear incidència
        </button>
      </form>
    </div>
  </div>

  <script id="students-data" type="application/json">{studentsJson}</script>
</MainLayout>

<script>
  const students = JSON.parse(
    document.getElementById("students-data")?.textContent || "[]"
  );
  const classSelect = document.getElementById("class-select");
  const kidSelect = document.getElementById("kid-select");

  function updateKids() {
    const selectedClass = classSelect?.value;
    kidSelect.innerHTML = '<option value="">Selecciona un alumne</option>';
    if (!selectedClass) {
      kidSelect.disabled = true;
      return;
    }
    kidSelect.disabled = false;
    const filtered = students.filter((s) => s.classGroup === selectedClass);
    filtered.forEach((s) => {
      const option = document.createElement("option");
      option.value = s.id;
      option.textContent = s.name;
      kidSelect.appendChild(option);
    });
  }

  classSelect?.addEventListener("change", updateKids);

  const toggleHiddenInputs = document.querySelectorAll(
    'input[type="hidden"][value="off"]'
  );
  toggleHiddenInputs.forEach((hidden) => {
    const checkbox = hidden.nextElementSibling;
    if (checkbox && checkbox.type === "checkbox") {
      checkbox.addEventListener("change", () => {
        hidden.value = checkbox.checked ? "on" : "off";
      });
    }
  });
</script>
