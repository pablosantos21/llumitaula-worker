---
import MainLayout from "../../../layouts/MainLayout.astro";
import { getIncidentById, updateIncident } from "../../../lib/incidents";
import { incidentCategoryLabel } from "../../../lib/incidentCategories";

const { id } = Astro.params;
if (!id) return Astro.redirect("/");

const incident = await getIncidentById(id);

if (!incident) {
  return Astro.redirect("/");
}

let submitted = false;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const seen = formData.get("seen") === "on";
  const response = formData.get("response")?.toString() || "";

  await updateIncident(id, {
    family_seen: seen,
    family_response: response,
    family_responded_at: new Date().toISOString(),
  });
  submitted = true;
}

const studentFullName = incident.child
  ? `${incident.child.first_name} ${incident.child.last_name}`
  : "Desconegut";
const studentClass = incident.child?.class?.name || "";
---

<MainLayout title="Respon a la incidència">
  <div class="flex-1 flex flex-col">
    <header class="bg-emerald-600 px-5 pt-6 pb-10 text-white">
      <h1 class="text-2xl font-bold">Incidència</h1>
      <p class="text-emerald-100 text-sm mt-1">
        {studentFullName} · {studentClass}
      </p>
    </header>

    <div class="flex-1 px-4 -mt-6 pb-6">
      {submitted ? (
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 text-center space-y-4">
          <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-8 h-8 text-emerald-600">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-900">Rebuda!</h2>
          <p class="text-slate-500">
            La teva resposta ha estat enviada correctament. El monitor la revisarà properament.
          </p>
        </div>
      ) : (
        <div class="space-y-4">
          <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
            <p class="text-xs text-slate-500 font-medium uppercase tracking-wider mb-1">
              Categoria
            </p>
            <p class="text-sm font-bold text-slate-800 mb-3">
              {incidentCategoryLabel(incident.category)}
            </p>
            <p class="text-xs text-slate-500 font-medium uppercase tracking-wider mb-1">
              Descripció
            </p>
            <p class="text-slate-900">{incident.description || "Sense descripció"}</p>
            <p class="text-xs text-slate-400 mt-3">
              {incident.date
                ? new Date(incident.date).toLocaleDateString("ca-ES", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })
                : ""}
            </p>
          </div>

          <form method="POST" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 space-y-4">
            <label class="flex items-center gap-3 cursor-pointer touch-manipulation">
              <input
                type="checkbox"
                name="seen"
                class="w-5 h-5 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
              />
              <span class="text-sm font-medium text-slate-700">
                He vist i entenc aquesta incidència
              </span>
            </label>

            <div class="flex flex-col gap-1.5">
              <label for="family-response" class="text-sm font-medium text-slate-700 ml-1">
                Resposta (opcional)
              </label>
              <textarea
                id="family-response"
                name="response"
                rows="4"
                placeholder="Escriu aquí la teva resposta..."
                class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-900 placeholder:text-slate-400 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full h-12 bg-emerald-600 text-white rounded-xl font-medium text-base flex items-center justify-center gap-2 active:scale-[0.98] transition-transform shadow-sm hover:bg-emerald-700"
            >
              Enviar resposta
            </button>
          </form>
        </div>
      )}
    </div>
  </div>
</MainLayout>
