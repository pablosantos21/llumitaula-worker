---
import MainLayout from "../layouts/MainLayout.astro";
import Input from "../components/Input";
import PrimaryButton from "../components/PrimaryButton";

const redirect = Astro.url.searchParams.get("redirect") || "/classes";

let error: string | null = null;

if (Astro.request.method === "POST") {
    try {
        const formData = await Astro.request.formData();
        const code = formData.get("code")?.toString();

        if (!code) {
            error = "Por favor, introduce el código del monitor";
        } else if (!/^\d+$/.test(code)) {
            error = "El código debe ser numérico";
        } else {
            return Astro.redirect(`/api/login?code=${code}&redirect=${encodeURIComponent(redirect)}`);
        }
    } catch (e) {
        error = "Error al procesar el formulario";
        console.error("Form processing error:", e);
    }
}
---

<MainLayout title="Login Monitor">
    <div class="flex-1 flex flex-col justify-center px-6 py-12 bg-white">
        <div class="w-full max-w-sm mx-auto space-y-8">
            <div class="text-center space-y-2">
                <h1 class="text-3xl font-bold tracking-tight text-emerald-900">
                    Llumitaula
                </h1>
                <p class="text-slate-500">Acceso para monitores</p>
            </div>

            {error && (
                <div class="p-4 rounded-lg bg-red-50 border border-red-200">
                    <p class="text-sm font-medium text-red-800">{error}</p>
                </div>
            )}

            <form class="space-y-6" method="POST">
                <Input
                    type="text"
                    name="code"
                    label="Código del Monitor"
                    placeholder="Ej: 1234"
                    required
                />

                <div class="pt-2">
                    <PrimaryButton type="submit" fullWidth>
                        Entrar
                    </PrimaryButton>
                </div>
            </form>
        </div>
    </div>
</MainLayout>
