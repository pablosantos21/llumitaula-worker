---
import MainLayout from "../layouts/MainLayout.astro";
import StudentCard from "../components/StudentCard.astro";
import IncidentModal from "../components/IncidentModal.astro";
import FeedbackToast from "../components/FeedbackToast.astro";
import { MOCK_STUDENTS } from "../lib/mocks";

// In a real app this would filter based on URL params or client-side JS
const allStudents = MOCK_STUDENTS;
---

<MainLayout title="Buscar Alumno">
    <!-- Sticky Header -->
    <header
        class="sticky top-0 z-40 bg-white/80 backdrop-blur-md border-b border-slate-200 px-4 py-3"
    >
        <div class="flex items-center gap-3">
            <a
                href="/"
                class="p-2 -ml-2 text-slate-500 hover:text-slate-800 rounded-full hover:bg-slate-100"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="w-6 h-6"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
                </svg>
            </a>
            <div class="flex-1 relative">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"
                >
                    <path
                        fill-rule="evenodd"
                        d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                        clip-rule="evenodd"></path>
                </svg>
                <input
                    type="search"
                    placeholder="Buscar alumno..."
                    class="w-full h-10 pl-10 pr-4 rounded-xl bg-slate-100/50 border border-slate-200 focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 outline-none transition-all text-sm"
                />
            </div>
        </div>
    </header>

    <div class="p-4 pb-24">
        <h2
            class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-2"
        >
            Resultados
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {allStudents.map((student) => <StudentCard student={student} />)}
        </div>
    </div>

    <IncidentModal />
    <FeedbackToast />
</MainLayout>

<script>
    // Simple client-side search simulation
    const searchInput = document.querySelector('input[type="search"]');
    const cards = document.querySelectorAll(".student-card");

    searchInput?.addEventListener("input", (e) => {
        const query = (e.target as HTMLInputElement).value.toLowerCase();
        cards.forEach((card) => {
            const name =
                card.getAttribute("data-student-name")?.toLowerCase() || "";
            // @ts-ignore
            if (name.includes(query)) {
                (card as HTMLElement).style.display = "flex";
            } else {
                (card as HTMLElement).style.display = "none";
            }
        });
    });
</script>
