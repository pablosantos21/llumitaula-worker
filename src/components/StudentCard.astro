---
import MealStatusBadge from "./MealStatusBadge.astro";
import type { Student, MealRecord } from "../lib/mocks";

interface Props {
    student: Student;
    record?: MealRecord;
}

const { student, record } = Astro.props;
// Default to all good if no record exists
const status = record?.status || "all_good";
---

<article
    class="student-card bg-white p-4 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between active:scale-[0.98] transition-transform touch-manipulation cursor-pointer"
    data-student-id={student.id}
    data-student-name={student.name}
    data-current-status={status}
>
    <div class="flex items-center gap-4">
        <div
            class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 font-bold text-lg overflow-hidden shrink-0"
        >
            {
                student.photoUrl ? (
                    <img
                        src={student.photoUrl}
                        alt={student.name}
                        class="w-full h-full object-cover"
                    />
                ) : (
                    student.name.substring(0, 2).toUpperCase()
                )
            }
        </div>

        <div>
            <h3 class="font-bold text-slate-900 leading-tight">
                {student.name}
            </h3>
            <div class="flex items-center gap-2 mt-1">
                {
                    student.allergies && student.allergies.length > 0 && (
                        <span class="text-xs font-bold text-red-600 bg-red-50 px-1.5 py-0.5 rounded border border-red-100">
                            {student.allergies.join(", ")}
                        </span>
                    )
                }
            </div>
        </div>
    </div>

    <div class="status-indicator">
        <MealStatusBadge status={status} />
    </div>
</article>

<script>
    // Simple interactions can be handled here or at page level.
    // Dispatching custom event for page-level handling is cleaner.
    document.querySelectorAll(".student-card").forEach((card) => {
        card.addEventListener("click", () => {
            const id = card.getAttribute("data-student-id");
            const name = card.getAttribute("data-student-name");
            const status = card.getAttribute("data-current-status");

            const event = new CustomEvent("open-student-modal", {
                detail: { id, name, status },
            });
            document.dispatchEvent(event);
        });
    });
</script>
