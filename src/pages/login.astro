---
import MainLayout from "../layouts/MainLayout.astro";
import AuthLoginForm from "../components/AuthLoginForm";
---

<MainLayout title="Login Monitor" requiresAuth={false}>
  <div class="flex-1 flex flex-col justify-center px-6 py-12 bg-white">
    <div class="w-full max-w-sm mx-auto space-y-8">
      <div class="text-center space-y-2">
        <h1 class="text-3xl font-bold tracking-tight text-emerald-900">
          Llumitaula
        </h1>
        <p class="text-slate-500">Acceso para monitores</p>
      </div>

      <AuthLoginForm client:load />
    </div>
  </div>
</MainLayout>
