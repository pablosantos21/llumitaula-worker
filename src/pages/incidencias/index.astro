---
import MainLayout from "../../layouts/MainLayout.astro";
import { getIncidentsByMonitor, updateIncident } from "../../lib/incidents";

const monitorId = Astro.cookies.get("monitor_id")?.value;

if (!monitorId) {
  return Astro.redirect("/login?redirect=/incidencias");
}

// Handle validate action
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action")?.toString();
  const incidentId = formData.get("id")?.toString();

  if (action === "validate" && incidentId) {
    await updateIncident(incidentId, {
      monitor_validated: true,
      reviewed: true,
    });
  }
}

const myIncidents = await getIncidentsByMonitor(monitorId);
const pending = myIncidents.filter(
  (i) => !i.reviewed && i.requires_family_signature && !i.family_seen,
);
const responded = myIncidents.filter(
  (i) => !i.reviewed && i.requires_family_signature && i.family_seen && !i.monitor_validated,
);
const totalPending = pending.length + responded.length;

function studentName(i: typeof myIncidents[number]): string {
  if (!i.child) return "Desconegut";
  return `${i.child.first_name} ${i.child.last_name}`;
}

function classGroup(i: typeof myIncidents[number]): string {
  if (!i.child?.class) return "";
  return i.child.class.name;
}
---

<MainLayout title="Incidències">
  <div class="flex-1 flex flex-col min-h-0">
    <header
      class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 py-3 flex items-center justify-between shadow-sm"
    >
      <a href="/" class="p-2 -ml-2 text-slate-500 hover:text-slate-800 rounded-full hover:bg-slate-100">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
      </a>
      <h1 class="text-lg font-bold text-slate-900">Incidències</h1>
      <div class="w-10"></div>
    </header>

    <div class="flex-1 overflow-y-auto px-4 pt-4 pb-6 space-y-6">
      <!-- Nova incidència -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
        <h2 class="text-base font-bold text-slate-800 mb-3">
          Comunicar nova incidència
        </h2>
        <p class="text-sm text-slate-500 mb-4">
          Notifica una incidència d'un alumne.
        </p>
        <a
          href="/incidencias/nova"
          class="inline-flex items-center justify-center h-12 px-6 rounded-xl text-base font-medium bg-emerald-600 text-white hover:bg-emerald-700 transition-colors active:scale-[0.98] w-full"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 mr-2">
            <path d="M10.362 1.093a.75.75 0 00-.724 0L2.523 5.018 10 9.143l7.477-4.125-7.115-3.925zM18 6.443l-7.25 4v8.25l6.862-3.786A.75.75 0 0018 14.25V6.443zm-8.75 12.25v-8.25l-7.25-4v7.807a.75.75 0 00.388.657l6.862 3.786z" />
          </svg>
          Nova incidència
        </a>
      </div>

      <!-- Per revisar -->
      <div>
        <h2 class="text-base font-bold text-slate-800 flex items-center gap-2 mb-3">
          Per revisar
          {totalPending > 0 && (
            <span class="text-xs bg-amber-100 text-amber-700 font-bold px-2 py-0.5 rounded-full">
              {totalPending}
            </span>
          )}
        </h2>

        {pending.length > 0 && (
          <div class="space-y-2 mb-4">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wider px-1">
              Pendents de resposta familiar
            </p>
            {pending.map((incident) => (
              <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4">
                <div class="flex items-start justify-between">
                  <div>
                    <p class="font-bold text-slate-900">{studentName(incident)}</p>
                    <p class="text-xs text-slate-500">{classGroup(incident)}</p>
                  </div>
                  <span class="text-xs bg-amber-50 text-amber-600 font-medium px-2 py-1 rounded-full border border-amber-100">
                    Pendents
                  </span>
                </div>
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {incident.send_notification && (
                    <span class="text-xs bg-blue-50 text-blue-600 px-2 py-1 rounded-lg border border-blue-100">
                      Notificació enviada
                    </span>
                  )}
                </div>
                {incident.description && (
                  <p class="text-sm text-slate-600 mt-2 italic">"{incident.description}"</p>
                )}
                <div class="mt-3 pt-3 border-t border-slate-100">
                  <a
                    href={`/incidencias/${incident.id}/respond`}
                    class="text-xs font-medium text-emerald-600 hover:text-emerald-700"
                  >
                    Compartir enllaç familiar →
                  </a>
                </div>
              </div>
            ))}
          </div>
        )}

        {responded.length > 0 && (
          <div class="space-y-2 mb-4">
            <p class="text-xs font-medium text-slate-400 uppercase tracking-wider px-1">
              Respostes per validar
            </p>
            {responded.map((incident) => (
              <div class="bg-white rounded-2xl shadow-sm border border-emerald-100 p-4">
                <div class="flex items-start justify-between">
                  <div>
                    <p class="font-bold text-slate-900">{studentName(incident)}</p>
                    <p class="text-xs text-slate-500">{classGroup(incident)}</p>
                  </div>
                  <span class="text-xs bg-emerald-50 text-emerald-600 font-medium px-2 py-1 rounded-full border border-emerald-100">
                    Resposta rebuda
                  </span>
                </div>
                <div class="mt-3">
                  <p class="text-xs text-slate-500 font-medium mb-1">Resposta de la família:</p>
                  <p class="text-sm text-slate-700 bg-slate-50 rounded-xl p-3 italic">
                    "{incident.family_response}"
                  </p>
                </div>
                <form method="POST" class="mt-3">
                  <input type="hidden" name="action" value="validate" />
                  <input type="hidden" name="id" value={incident.id} />
                  <button
                    type="submit"
                    class="w-full h-11 bg-emerald-600 text-white rounded-xl font-medium text-sm flex items-center justify-center gap-2 active:scale-[0.98] transition-transform shadow-sm hover:bg-emerald-700"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                      <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                    </svg>
                    Validar i tancar
                  </button>
                </form>
              </div>
            ))}
          </div>
        )}

        {totalPending === 0 && (
          <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 text-center mb-3">
            <p class="text-slate-400 text-sm">No hi ha incidències pendents de revisar</p>
          </div>
        )}

        <a
          href="/incidencias/anteriors"
          class="flex items-center justify-center h-12 rounded-xl text-base font-medium border-2 border-slate-200 text-slate-700 bg-white hover:border-slate-300 transition-colors active:scale-[0.98]"
        >
          Veure incidències anteriors
        </a>
      </div>
    </div>
  </div>
</MainLayout>
