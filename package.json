{
  "name": "llumitaula-worker",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:vite": "vite --port 4321",
    "build": "astro build",
    "build:vite": "vite build",
    "prebuild": "pnpm run generate:pwa-assets",
    "postbuild": "node scripts/generate-pwa-service-worker.mjs",
    "generate:pwa-assets": "node scripts/generate-pwa-assets.mjs",
    "preview": "astro preview",
    "preview:vite": "vite preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:auth-guard": "node --test tests/auth-guard.test.mjs",
    "test:router-scaffold": "node --test tests/router-scaffold.test.mjs",
    "test:classes": "node --test tests/classes.test.mjs",
    "test:daily-list": "node --test tests/daily-list.test.mjs",
    "test:attendance": "node --test tests/attendance.test.mjs",
    "test:attendance-confirm": "node --test tests/attendance-confirm.test.mjs",
    "test:attendance-gating": "node --test tests/attendance-gating.test.mjs",
    "test:attendance-blocking": "node --test tests/attendance-blocking.test.mjs",
    "test:meal-list": "node --test tests/meal-list.test.mjs",
    "test:meal-draft": "node --test tests/meal-draft.test.mjs",
    "test:incidents": "node --test tests/incidents.test.mjs",
    "test:pwa:unit": "node --test tests/pwa.test.mjs",
    "test:pwa:contract": "pnpm run build && pnpm run test:public-data && pnpm run test:pwa:unit",
    "test:pwa": "pnpm run test:pwa:contract",
    "test:device-setup": "node --test tests/device-setup.test.mjs",
    "test:public-data": "node scripts/check-public-build.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.4",
    "@supabase/supabase-js": "2.110.9",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.16"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
